{
  "name": "offbeat",
  "version": "1.0.2",
  "description": "A Beat-style screenwriting app for Windows, using the Fountain format",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win dir"
  },
  "author": "Pat Crowley",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@fontsource/courier-prime": "^5.3.0",
    "codemirror": "^5.65.21",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "nspell": "^2.1.5"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "resedit": "^3.1.0"
  },
  "productName": "Offbeat",
  "build": {
    "appId": "com.patcrowley.offbeat",
    "productName": "Offbeat",
    "copyright": "Offbeat contributors",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "!**/*.map"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "fileAssociations": [
      {
        "ext": "fountain",
        "name": "Fountain Screenplay",
        "description": "Fountain Screenplay",
        "role": "Editor"
      },
      {
        "ext": "spmd",
        "name": "Fountain Screenplay",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Offbeat"
    },
    "afterPack": "scripts/stamp-exe.js",
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patcrowley/offbeat.git"
  },
  "homepage": "https://github.com/patcrowley/offbeat",
  "bugs": {
    "url": "https://github.com/patcrowley/offbeat/issues"
  }
}
